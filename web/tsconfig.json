{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
