# Copy to .env. Never commit real secrets.
DATABASE_URL=postgres://postgres@localhost:5433/candy
SESSION_SECRET=change-me-long-random
SECRETS_MASTER_KEY=base64-32-bytes-generate-with-openssl-rand-base64-32
ANTHROPIC_API_KEY=            # connection 1 — leave empty until connected
TZ_CLINIC=Asia/Kuala_Lumpur
STORAGE_DIR=storage           # private uploads (git-ignored); back this folder up
UPLOAD_MAX_MB=500             # largest single training upload
WORKER_TOKEN=                 # long random value; lets a Claude session answer chats as staff (chat only)
# --- Hosting only (see docs/DEPLOY.md); leave unset on this PC ---
# HOST=0.0.0.0                # listen publicly (requires COOKIE_SECURE=true)
# PORT=3100
# COOKIE_SECURE=true          # behind HTTPS; also enables HSTS
# TRUST_PROXY=1               # one proxy hop in front (Render/Railway/Fly/Caddy)
# PGSSLMODE=require           # TLS to a hosted database (or verify-full + PGSSLROOTCERT_PEM)
# ASSETS_DIR=/data/assets     # posters/video on the host's disk (missing files copied from the app, never overwritten)
# CANDY_URL=https://...       # for `pnpm worker` on this PC once the app is hosted
